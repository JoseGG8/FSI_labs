# =============================================================================
# Plantilla Consolidada de Variables de Entorno — eBookStore (Monorepo)
# Copia las secciones correspondientes a server/.env y web/.env.local
# NUNCA subas credenciales reales al repositorio Git.
# =============================================================================

# -----------------------------------------------------------------------------
# BACKEND (server/.env)
# -----------------------------------------------------------------------------
PORT=4000
NODE_ENV=development

# MongoDB Atlas (reemplaza <usuario>, <password> y <cluster>)
MONGODB_URI=mongodb+srv://<usuario>:<password>@<cluster>.mongodb.net/ebookstore?retryWrites=true&w=majority

# Autenticación JWT
JWT_SECRET=reemplaza_con_un_secreto_aleatorio_seguro_de_al_menos_32_caracteres
JWT_EXPIRES_IN=7d

# CORS (URL del frontend; en producción usa tu dominio de Railway)
CORS_ORIGIN=http://localhost:3000

# PayPal Sandbox (PayPal Developer Dashboard -> Apps & Credentials)
PAYPAL_MODE=sandbox
PAYPAL_CLIENT_ID=tu_paypal_sandbox_client_id
PAYPAL_CLIENT_SECRET=tu_paypal_sandbox_client_secret
PAYPAL_CURRENCY=USD

# -----------------------------------------------------------------------------
# FRONTEND (web/.env.local)
# -----------------------------------------------------------------------------
NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_SOCKET_URL=http://localhost:4000
NEXT_PUBLIC_PAYPAL_CLIENT_ID=tu_paypal_sandbox_client_id
