# =============================================================================
# Variables de Entorno del Backend (server/.env)
# =============================================================================
PORT=4000
NODE_ENV=development

# MongoDB Atlas
MONGODB_URI=mongodb+srv://<usuario>:<password>@<cluster>.mongodb.net/ebookstore?retryWrites=true&w=majority

# JWT
JWT_SECRET=reemplaza_con_un_secreto_aleatorio_seguro_de_al_menos_32_caracteres
JWT_EXPIRES_IN=7d

# CORS (URL del frontend permitido)
CORS_ORIGIN=http://localhost:3000

# PayPal Sandbox
PAYPAL_MODE=sandbox
PAYPAL_CLIENT_ID=tu_paypal_sandbox_client_id
PAYPAL_CLIENT_SECRET=tu_paypal_sandbox_client_secret
PAYPAL_CURRENCY=USD
